# ─── Stage 1: Build ───────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /app

# Copy Maven wrapper + pom first (layer cache — only re-downloads deps if pom changes)
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B

# Copy source and build JAR (skip tests — tests run in CI, not Docker build)
COPY src src
RUN ./mvnw package -DskipTests -B

# ─── Stage 2: Run ─────────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache curl

WORKDIR /app

COPY --from=builder /app/target/url-shortener-0.0.1-SNAPSHOT.jar app.jar

# Pin our retained DB-IP Lite copy so upstream monthly cleanup cannot break builds.
RUN curl -fsSL https://github.com/madhavthesiya/shunyalink/releases/download/geoip-dbip-country-2026-10/dbip-country-lite-2026-10.mmdb.gz -o /tmp/dbip.mmdb.gz \
    && echo '4cd44536ddfd40fec7eca94a233f7d19f38d470e6522e653cb8d27001f5fe177  /tmp/dbip.mmdb.gz' | sha256sum -c - \
    && gunzip -c /tmp/dbip.mmdb.gz > /app/dbip-country.mmdb \
    && rm /tmp/dbip.mmdb.gz

# Commit this image was built from, published at /actuator/info (CI passes --build-arg).
# Declared last so changing it never invalidates the cached layers above.
ARG APP_COMMIT=unknown
ENV APP_COMMIT=${APP_COMMIT}

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
